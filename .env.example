# Local docker-compose Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://oneatlas:oneatlas@localhost:5432/oneatlas?schema=public"
# Used by `prisma migrate`. On Neon: DATABASE_URL = pooled URL, DIRECT_URL = direct (non-pooled) URL.
DIRECT_URL="postgresql://oneatlas:oneatlas@localhost:5432/oneatlas?schema=public"

PORT=3000
# Protects write endpoints (POST/PATCH/PUT/DELETE). Leave empty to disable them entirely.
ADMIN_API_KEY="change-me"
# Rate limit: requests per minute per IP
THROTTLE_LIMIT=120
# Cache TTL (seconds) for list/ranking endpoints
CACHE_TTL_SECONDS=60
